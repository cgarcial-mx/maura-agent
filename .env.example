# PostgreSQL (Neon). La app usa la string "pooled" (pgbouncer); las migraciones
# (drizzle-kit migrate) usan la string "directa". Ambas incluyen ?sslmode=require.
DATABASE_URL=postgres://maura:maura@localhost:5432/maura

# LLM (DeepSeek — API OpenAI-compatible). Sin API key, el servidor arranca en
# fail-closed "sigo observando". Contrato de privacidad: zero-retention, no-training, DPA.
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_MS=8000

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Portabilidad / borrado self-service (enlace "unsubscribe")
PORTABILITY_SECRET=
PUBLIC_URL=http://localhost:3000
